# ---------------------------------------------------------------
# VELTRIO backend environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The server refuses to start while placeholder values remain.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (include the database name "veltrio").
# Special characters in the password must be URL-encoded.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/veltrio?retryWrites=true&w=majority

# Used from Phase 2 (authentication). Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# bcrypt cost factor (10-15, 12 is a solid default). Used from Phase 2.
BCRYPT_SALT_ROUNDS=12

# Allowed frontend origin(s) for CORS. Comma-separate several.
# Production: your deployed frontend URL, e.g. https://veltrio.vercel.app
CLIENT_URL=http://localhost:5173

# Password-reset email (Phase 2). Optional in development: the reset link is logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VELTRIO <no-reply@veltrio.app>"

# Used only by backend/scripts/seedAdmin.js (Phase 9) to create the first admin account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
