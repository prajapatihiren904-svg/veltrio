# ---------------------------------------------------------------
# VELTRIO frontend environment template.
# Copy to `.env` if you need to change anything. Only variables prefixed with
# VITE_ reach the browser, so NEVER put secrets here.
# ---------------------------------------------------------------

# Development only: where the Vite dev server proxies /api requests (not exposed to the browser).
API_PROXY_TARGET=http://localhost:5000

# Production only: the deployed API base URL, e.g. https://api.yourdomain.com/api/v1
# Leave empty in development (requests go through the proxy above).
VITE_API_URL=

VITE_APP_NAME=VELTRIO
